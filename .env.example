# Copy to .env.local for development. In CI these come from GitHub repository secrets.
# With no Firebase values, the app runs in clearly labelled on-device (local-only) mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Storage requires the Firebase Blaze plan. Leave false to keep audio on the device (IndexedDB).
VITE_FIREBASE_STORAGE_ENABLED=false

# Local testing only: connect to the Firebase Emulator Suite.
VITE_USE_EMULATORS=false
